{
    "name": "rafalmasiarek/real-ip-resolver",
    "description": "Secure and extensible real IP resolver for PHP applications behind proxies and load balancers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11",
        "psr/http-server-middleware": "^1.0"
    },
    "suggest": {
        "psr/http-server-middleware": "Required to use RealIpResolverMiddleware (PSR-15 middleware)."
    },
    "autoload": {
        "psr-4": {
            "rafalmasiarek\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
